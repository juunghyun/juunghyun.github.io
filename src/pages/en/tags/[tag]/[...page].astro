---
import type { GetStaticPaths } from "astro";
import TagPage from "@/components/pages/TagPage.astro";
import { getTagPaths } from "@/utils/routes";

export const getStaticPaths = (async options =>
  getTagPaths("en", options)) satisfies GetStaticPaths;
---

<TagPage page={Astro.props.page} tagName={Astro.props.tagName} />
