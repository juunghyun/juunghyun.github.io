---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getAlternates, otherLocale, resolveLocale } from "@/utils/i18n";
import config from "@/config";

type Props = {
  /** src/content/pages/<locale>/<slug>.md */
  slug: "about" | "projects";
};

const { slug } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const page = await getEntry("pages", `${locale}/${slug}`);

if (!page) {
  throw new Error(
    `Missing content entry: src/content/pages/${locale}/${slug}.md`
  );
}

const { Content } = await render(page);
const alternates = getAlternates(Astro.url.pathname, locale);
---

<Layout
  title={`${page.data.title} | ${config.site.title}`}
  description={page.data.description}
  ogImage={page.data.ogImage}
  canonicalURL={page.data.canonicalURL}
  {alternates}
>
  <Header alternateUrl={alternates[otherLocale(locale)]} />
  <Breadcrumb />
  <Main pageTitle={page.data.title} class="app-prose">
    <Content />
  </Main>
  <Footer />
</Layout>
