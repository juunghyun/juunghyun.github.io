---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getAlternates, otherLocale, resolveLocale } from "@/utils/i18n";
import config from "@/config";

const locale = resolveLocale(Astro.currentLocale);
const about = await getEntry("pages", `${locale}/about`);

if (!about) {
  throw new Error(
    `Missing content entry: src/content/pages/${locale}/about.md`
  );
}

const { Content } = await render(about);
const alternates = getAlternates(Astro.url.pathname, locale);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
  {alternates}
>
  <Header alternateUrl={alternates[otherLocale(locale)]} />
  <Breadcrumb />
  <Main pageTitle={about.data.title} class="app-prose">
    <Content />
  </Main>
  <Footer />
</Layout>
